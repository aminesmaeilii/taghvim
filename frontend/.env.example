# Only VITE_-prefixed variables are exposed to the browser bundle.
VITE_APP_NAME=Zambil Content Calendar
VITE_APP_ENV=production

# Must point at the backend's public URL (see ../backend). Leave empty ONLY
# if the frontend is served from the exact same origin as the backend and a
# reverse proxy forwards /api/* to it — otherwise this is required.
VITE_API_URL=https://your-backend-host.example.com

VITE_PUBLIC_WEB_PUSH_KEY=
VITE_VAPID_PUBLIC_KEY=
