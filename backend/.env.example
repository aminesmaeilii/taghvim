# Port the Node server listens on.
PORT=3000
NODE_ENV=production

# Origin(s) allowed to call this API (comma-separated). Must include the exact
# origin the frontend is served from (e.g. https://calendar.yourdomain.com).
FRONTEND_URL=
ALLOWED_ORIGINS=

# Required for persistent storage. Without these, data is written to a local
# file on disk and is lost on every restart/redeploy of this server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: first Super Admin account created on first boot. If left empty,
# the username defaults to "taghvim-root" and the password defaults to
# "Taghvim-Admin-2026" (see src/routes/auth.ts). Set your own here if you
# want a different default.
BOOTSTRAP_ADMIN_USERNAME=taghvim-root
BOOTSTRAP_ADMIN_PASSWORD=

# Required in production to protect the file-upload endpoint.
BLOB_UPLOAD_SECRET=
# Required for file uploads (attachments) via Vercel Blob storage, usable
# from any server, not just Vercel. Create a Blob store at vercel.com/storage
# and copy its token here.
BLOB_READ_WRITE_TOKEN=

